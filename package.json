{
  "name": "toki-shelf-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:localhost": "expo start --localhost --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:contract": "node --no-warnings --experimental-strip-types scripts/check-shelf-contract.mjs",
    "check:presets": "node --no-warnings --experimental-strip-types scripts/check-presets.mjs",
    "check:content": "node --no-warnings --experimental-strip-types scripts/check-content-flow.mjs",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
